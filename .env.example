# Server Configuration
HOST=127.0.0.1
PORT=3000

# Clustering
ENABLE_CLUSTERING=false

# Logging
# Valid levels: silent, error, warn, info (default: info)
LOG_LEVEL=info

# Graceful Shutdown
# Time in milliseconds to wait for in-flight requests to drain before force-killing (default: 5000)
SHUTDOWN_TIMEOUT=5000
