# =============================================================================
# Environment Configuration for Test1 - Staging-Approval Workflow
# =============================================================================
# Copy this file to `.env` and fill in the values for your environment.
# All values shown here are defaults or placeholders.

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Hostname the server binds to (default: 127.0.0.1)
HOSTNAME=127.0.0.1

# Port the server listens on (default: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# API Authentication
# -----------------------------------------------------------------------------
# Primary API key for authenticating approval, rejection, and promotion endpoints.
# Required for POST /api/approve/:id, POST /api/reject/:id, POST /api/promote/:id
BLITZY_CLIENT_API_KEY=your-api-key-here

# Additional API keys (available in environment)
BLITZY_CLIENT_API_KEY2=your-api-key-2-here
BLITZY_CLIENT_API_KEY3=your-api-key-3-here

# -----------------------------------------------------------------------------
# General Environment Variables
# -----------------------------------------------------------------------------
# Available environment variables provided by the platform
c=
d=
r=
